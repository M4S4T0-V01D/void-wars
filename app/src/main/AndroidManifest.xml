<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Haptics: every hit, graze and explosion is felt as well as heard. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- In-app updates (see Updater.kt): the only thing it goes online for. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:name=".WarsApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Void Wars"
        android:supportsRtl="true"
        android:isGame="true"
        android:appCategory="game"
        android:theme="@style/Theme.Void.Wars"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- ICON ALIASES (generated by art/gen_icon.py) -->
        <activity-alias
            android:name=".Icon_void"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_void"
            android:roundIcon="@mipmap/ic_launcher_void"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_nebula"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_nebula"
            android:roundIcon="@mipmap/ic_launcher_nebula"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_abyss"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_abyss"
            android:roundIcon="@mipmap/ic_launcher_abyss"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_phosphor"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_phosphor"
            android:roundIcon="@mipmap/ic_launcher_phosphor"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_ember"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ember"
            android:roundIcon="@mipmap/ic_launcher_ember"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_daylight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_daylight"
            android:roundIcon="@mipmap/ic_launcher_daylight"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Icon_high_contrast"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_high_contrast"
            android:roundIcon="@mipmap/ic_launcher_high_contrast"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- END ICON ALIASES -->

        <receiver android:name=".UpdateReceiver" android:exported="false" />
        <service
            android:name=".UpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
